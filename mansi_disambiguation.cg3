DELIMITERS = "<SENT_BOUNDARY>";

SET Proclitics = (procl) OR ("ōs"i);
SET NotProclitics = (*) - Proclitics;
LIST Poss = 1sg 2sg 3sg 1pl 2pl 3pl;
LIST PossNot3sg = 1sg 2sg 1pl 2pl 3pl;
SET NN = (N sg nom) - Poss;
SET NomPoss = (N sg nom 1sg) OR (N sg nom 2sg) OR (N sg nom 3sg) OR (N sg nom 1pl) OR (N sg nom 2pl) OR (N sg nom 3pl);
LIST NAdj = N ADJ;
SET V = (V) OR (N vbz);
SET VTr1 = (V tr) OR (V caus);
SET VTr2 = VTr1 - (pass);
LIST BOS = (>>>);
SET BOSPunct = (punct) | BOS;



SECTION    # Preverbs and other pro- and enclitics
REMOVE (procl)
    IF (0 NotProclitics)
       (NEGATE *1 V BARRIER NotProclitics)
       (*1 (N) OR (ADJ) OR (ADV) OR (NUM) OR (PRON) OR (POSTP) OR (INTRJ) OR (X) BARRIER NotProclitics)
       (NEGATE -1 ("<ja>"i));
SELECT (procl) IF (0 ("<juw>"i)) (-1 ("<ta>"i) OR ("<ti>"i));
SELECT (procl) IF (0 ("<ta>"i) OR ("<ti>"i)) (1 V);
SELECT (V npst 3.s sg.s) IF (0 ("<juw>"i))
                            (NEGATE 1 (V) OR Proclitics);

SELECT (CONJ rus) IF (0 ("<a>"i)) (-1 BOSPunct);


SECTION    # Verbs
# Select finite analyses with the correct subject agreement
SELECT (V npst 1.s du.s) IF (*-1 ("<mēn>"i) BARRIER V | BOSPunct)
                            (0 ("<.*mēn>"r))
                            (NEGATE 0 (V npst pass));

SELECT (V imp) IF (-1 ("<ul>"i));
SELECT (V imp) IF (-2 ("<ul>"i)) (-1 ("<=>"));

# Participles with possession markers are very rare and may be homonymous with the mirative forms
REMOVE (V ptcp_npst 3sg) IF (0 (V mir 3.s sg.s));

# Participles in character names
SELECT (V ptcp_npst) IF (-1 ("<mir>"i)) (0 ("<susne>"i)) (1 ("xum"));
REMOVE (V ptcp_npst 3sg) IF (-1 ("<mir>"i)) (0 ("<susne>"i)) (1 ("xum"));



SECTION    # Nouns
SELECT (N PN) IF (0 ("<moɕ>"i)) (1 ("nē") OR ("xum"));

# PL vs LOC
SELECT (N pl nom) IF (0 ("<.*t>"r)) (1 ("kīwər"));
SELECT (N loc) IF (0 ("<.*t>"r)) (0 (N topn));
SELECT (N pl nom) IF (0 ("<.*t>"r)) (0 (N persn) OR (N famn) OR (N anim) OR (N supernat) OR ("pora"));
SELECT (N pl nom) IF (0 ("<kolt>"r)) (1 ("ōl"));

# ABL vs. INS (-əl as ABL only in Upper Lozva, otherwise very restricted)
SELECT (N abl) IF (0 ("<pāwləl>i"));

# Only nominative in front of postpositions
SELECT (nom) IF (0 (N) OR (PRON)) (1 (POSTP));

# DU vs. TRAN
REMOVE (du nom) IF (0 (N trans) OR (A trans))
                   (1* (V w_trans) BARRIER (V) OR (A) OR (POSTP))
				   (NEGATE -1 ("<kit>"i))
				   (NEGATE -2 ("<kit>"i))
				   (NEGATE -3 ("<kit>"i))
				   (NEGATE 0* (V du.o) OR (V du.s));

# Random homonymy
SELECT (PRON) IF (0 ("<tān>"i)) (*1 ("sāŋkwəlt") OR ("ērɣ") BARRIER NotProclitics);

SELECT (NUM) IF (0 ("<s[aā]t>"r)) (1 ("<tal>") OR ("<tāl>") OR ("<ɕos>"));

SELECT (PRON) IF (0 ("<mān>"i)) (1 (N 1pl) OR (POSTP 1pl));
SELECT (N lat) IF (0 ("<mān>"i)) (1 ("<minas>"i) OR ("<minasət>"i));
